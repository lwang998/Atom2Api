{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atom2Api",
  "version": "1.0.11",
  "identifier": "io.github.lwang998.atom2api",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/atom2api-server"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
